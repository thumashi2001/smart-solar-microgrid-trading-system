<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmartSolarMicrogrid" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorPrimaryDark">@color/primary_green_dark</item>
        <item name="colorOnPrimary">@color/surface_white</item>
        <item name="android:colorBackground">@color/background_cream</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="android:statusBarColor">@color/dark_green</item>
        <item name="android:navigationBarColor">@color/dark_green</item>
    </style>

    <style name="Widget.SmartSolar.PrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_green</item>
        <item name="android:textColor">@color/surface_white</item>
    </style>

    <style name="Widget.SmartSolar.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/primary_green</item>
        <item name="android:textColor">@color/primary_green</item>
    </style>

    <!-- Thumashi Compose MainActivity window theme -->
    <style name="Theme.MicrogridApp" parent="android:Theme.Material.Light.NoActionBar" />
</resources>
